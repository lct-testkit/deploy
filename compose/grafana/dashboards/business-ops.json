{
  "id": null,
  "uid": "rtk-business-ops",
  "title": "RTK CRM — бизнес-метрики и эксплуатация",
  "description": "Очередь, фоновые задачи, аудит и доступность зависимостей — backend/app/core/metrics.py. SLA-панель помечена отдельно: соответствующие счётчики объявлены в backend, но пока нигде не инкрементируются (см. описание панели и тело PR).",
  "tags": ["rtk-crm", "ops"],
  "timezone": "",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "links": [],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Таргеты Prometheus",
      "description": "Встроенная метрика Prometheus `up` по каждому job из prometheus.yml — доступен ли сам эндпоинт /metrics (не путать со следующей панелью: там — что о своих зависимостях думает само приложение).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=~\"api|keycloak|prometheus\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Зависимости приложения (/health/ready)",
      "description": "crm_dependency_up{dependency} — что сам backend думает о доступности postgres/redis/keycloak/очереди/хранилища (app/api/health.py, пересчитывается на каждый вызов /health/ready).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "crm_dependency_up",
          "legendFormat": "{{dependency}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLA и отчёты — ждут подключения в backend",
      "description": "crm_sla_violations_total, crm_sla_breaching_deals и crm_reports_in_progress объявлены в backend/app/core/metrics.py, но на момент добавления этой панели (сентябрь 2026) ни разу не вызываются нигде в коде backend — ни sweep_sla_breaches (app/modules/crm/tasks.py), ни генерация отчётов не пишут в них, только в structlog/БД. Панель останется пустой (No data), пока backend не добавит .labels(...).inc()/.set() в нужных местах — см. тело PR со ссылками на конкретные файлы.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(crm_sla_breaching_deals)",
          "legendFormat": "сделок с нарушенным SLA",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(crm_sla_violations_total[5m]))",
          "legendFormat": "нарушений SLA/с",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "crm_reports_in_progress",
          "legendFormat": "отчётов в работе",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Зависимости приложения во времени",
      "description": "crm_dependency_up по времени — короткий провал виден здесь, даже если сейчас (в панели выше) уже снова UP.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 15, "spanNulls": false }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "crm_dependency_up",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Длина очереди arq",
      "description": "crm_queue_depth{queue} — снимается при каждом /health/ready (app/core/redis_client.py, zcard arq:queue).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 15, "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "crm_queue_depth",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Фоновые задачи за последний час",
      "description": "sum by (task) (increase(crm_background_tasks_total[1h])). Метка result сейчас всегда \"success\" — ни один из периодических sweep-джобов backend пока не пишет result=\"failure\"/\"error\" при исключении, поэтому это счётчик запусков (\"жив ли джоб вообще\"), а не честный success-rate: задача, переставшая работать, здесь просто исчезнет из таблицы или уйдёт в 0, а не покажет ошибку.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "result": true } } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (task) (increase(crm_background_tasks_total[1h]))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Записи аудита/с по действию",
      "description": "sum by (action) (rate(crm_audit_records_total[5m])) — backend/app/modules/audit/service.py.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" }, "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (action) (rate(crm_audit_records_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    }
  ]
}
