# /opt/rqlite/.env — свой на каждом узле (отличаются NODE_ID и NODE_IP). Файл с паролем читают только root: chmod 600.
NODE_ID=n1
NODE_IP=10.10.0.1
RQLITE_PEERS=10.10.0.1:4002,10.10.0.2:4002,10.10.0.3:4002
# Берётся из .env.images основного стека: grep '^RQLITE_IMAGE=' /opt/rtk-crm/compose/.env.images
RQLITE_IMAGE=
# Данные кластера (владелец — uid 1000, пользователь rqlite в образе) и файл пользователей.
RQLITE_DATA_DIR=/srv/rqlite
RQLITE_AUTH_FILE=/opt/rqlite/auth.json
