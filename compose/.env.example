# Переменные окружения прод-профиля RTK School CRM (docker-compose поверх
# готовых образов ghcr.io/lct-testkit/*). Список и дефолты — точная копия
# backend/.env.example, плюс пояснение про образы в самом низу.
#
# !!! ВНИМАНИЕ. Это ДЕМО-секреты — те же, что зашиты по умолчанию в backend
# (нужны, чтобы seed-данные и realm-crm.json совпадали "из коробки"). Перед
# любым реальным развёртыванием ОБЯЗАТЕЛЬНО замените минимум: POSTGRES_PASSWORD,
# CRM_APP_PASSWORD, KEYCLOAK_ADMIN_PASSWORD, KEYCLOAK_CLIENT_SECRET,
# KEYCLOAK_ADMIN_CLIENT_SECRET, SIGNATURE_SERVER_SECRET, S3_ACCESS_KEY,
# S3_SECRET_KEY — они помечены ниже пометкой "СМЕНИТЬ ДЛЯ PROD".
#
#   cp .env.example .env
#   # ... отредактировать .env ...
#   docker compose up -d

# --- Профиль: dev | demo | prod -----------------------------------------
APP_PROFILE=demo
BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
LOG_JSON=true

# --- Хранилища -----------------------------------------------------------
# Роль crm_app: только SELECT/INSERT на audit_log, без UPDATE/DELETE
# (new_spec §3.3) — не суперпользователь crm/POSTGRES_PASSWORD ниже.
DATABASE_URL=postgresql+asyncpg://crm_app:crm_app@localhost:5432/crm
# Только для `alembic upgrade head` вне docker compose. Внутри docker
# compose это учтено отдельным DATABASE_URL сервиса `migrate` (см.
# docker-compose.yml) — эта переменная нужна только при запуске alembic
# локально напрямую.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm
KC_DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/keycloak
REDIS_URL=redis://localhost:6379/0

# --- Keycloak ------------------------------------------------------------
# Публичный адрес: из него формируется issuer токенов и ссылка входа. На
# реальном сервере замените localhost:8080 на публичный домен/IP.
KEYCLOAK_URL=http://localhost:8080/auth
# Адрес для серверных вызовов внутри контура. В docker-compose задаётся
# автоматически как http://keycloak:8080/auth.
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=crm
KEYCLOAK_CLIENT_ID=crm-bff
# СМЕНИТЬ ДЛЯ PROD
KEYCLOAK_CLIENT_SECRET=crm-bff-secret
KEYCLOAK_ADMIN_CLIENT_ID=crm-admin
# СМЕНИТЬ ДЛЯ PROD
KEYCLOAK_ADMIN_CLIENT_SECRET=crm-admin-secret
KEYCLOAK_JWKS_TTL=3600
# Включать, когда у клиента настроен audience-mapper (в поставляемом realm он есть).
KEYCLOAK_VERIFY_AUDIENCE=true

# --- SeaweedFS (S3-совместимое хранилище; MinIO запрещён) ----------------
S3_ENDPOINT_URL=http://localhost:8333
# Адрес presigned-ссылок, которые разыменовывает браузер клиента. Оставлен
# закомментированным: docker-compose использует дефолт (http://localhost:8333),
# совпадающий с S3_ENDPOINT_URL выше — раскомментировать, только если адреса
# должны разойтись (например, реальный домен сервера).
# S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
# СМЕНИТЬ ДЛЯ PROD
S3_ACCESS_KEY=crm_access
# СМЕНИТЬ ДЛЯ PROD
S3_SECRET_KEY=crm_secret_key
S3_REGION=us-east-1
S3_BUCKET_FILES=files
S3_BUCKET_IMPORTS=imports
S3_BUCKET_REPORTS=reports
S3_BUCKET_SIGNATURES=signatures
S3_BUCKET_REGISTRY=registry

# --- Сессии и токены -----------------------------------------------------
SESSION_TTL=43200
SESSION_IDLE_TIMEOUT=1800
ACCESS_TOKEN_TTL=300
REFRESH_TOKEN_TTL=28800
ACCESS_TOKEN_REFRESH_LEEWAY=30
CSRF_ENABLED=true
CSRF_COOKIE_NAME=crm_csrf
CSRF_HEADER_NAME=X-CSRF-Token
# Прямой вход по Authorization: Bearer в обход серверной сессии. В prod
# автоматически ограничивается ролью INTEGRATION.
ALLOW_BEARER_AUTH=true

# --- Файлы ---------------------------------------------------------------
FILES_MAX_SIZE_BYTES=52428800
DEAL_FILES_MAX_SIZE_BYTES=524288000
# SVG запрещён спецификацией.
ALLOWED_FILE_EXTENSIONS=png,jpeg,jpg,pdf,zip,gz,gzip,rar,doc,docx,xls,xlsx,xml,csv,json

# --- Отчёты --------------------------------------------------------------
REPORTS_MAX_CONCURRENT=10
REPORTS_LINK_TTL_MINUTES=15
REPORTS_RETENTION_DAYS=7

# --- Импорт --------------------------------------------------------------
IMPORT_MAX_ROWS=100000
IMPORT_MAX_FILE_SIZE_BYTES=52428800
IMPORT_BATCH_SIZE=500

# --- Автоподстановка по ИНН ---------------------------------------------
ORG_LOOKUP_RATE_LIMIT_PER_MIN=30
EXTERNAL_ORG_LOOKUP_ENABLED=false

# --- ПЭП -----------------------------------------------------------------
PUBLIC_SIGN_RATE_LIMIT_PER_MIN=10
SIGNATURE_TOKEN_TTL_DAYS=7
SIGNATURE_OTP_TTL_SECONDS=300
SIGNATURE_OTP_MAX_ATTEMPTS=3
# СМЕНИТЬ ДЛЯ PROD — используется для HMAC-метки целостности подписи.
SIGNATURE_SERVER_SECRET=change-me-in-prod
SIGNATURE_KEY_VERSION=1
# Ключи, которые gen_env.sh создаёт случайными (пусто — функция выключена): HMAC цепочки аудита (хэш v3) и ключ
# шифрования секретных системных настроек (Fernet: 32 байта в url-safe base64).
AUDIT_HMAC_KEY=
SETTINGS_ENCRYPTION_KEY=
# Отдавать код подтверждения подписи в ответе (только демо и тесты).
SIGNATURE_EXPOSE_DEBUG_OTP=
# Почта: ссылки подписантам и email-уведомления. Без SMTP_HOST письма остаются в очереди.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
BITRIX_SOURCE_ID=OTHER
# Доверенное время (dop.md §10.8/§13) — контейнеры `ntp`/`sms-gateway-mock`
# всегда часть стека (см. docker-compose.yml).
NTP_HOST=ntp
NTP_PORT=123
NTP_TIMEOUT_SECONDS=2.0
SIGNATURE_MAX_CLOCK_DRIFT_MS=5000
SMS_GATEWAY_URL=http://sms-gateway-mock:8090

# --- Интеграции ----------------------------------------------------------
# *_REF — имя переменной окружения, где реально лежит секрет (раздел 7.8:
# «ссылка на секрет, НЕ сам секрет»), не значение.
CMS_WEBHOOK_SECRET_REF=CMS_WEBHOOK_SECRET
CMS_WEBHOOK_SECRET=
LMS_BASE_URL=
LMS_AUTH_REF=
BITRIX_CONNECTOR_ENABLED=false
BITRIX_WEBHOOK_URL_REF=BITRIX_WEBHOOK_URL
# Секрет — это весь URL входящего вебхука целиком
# (https://{портал}/rest/{user_id}/{webhook_code}), см. `integration/bitrix.py`.
BITRIX_WEBHOOK_URL=
INTEGRATION_WEBHOOK_RATE_LIMIT_PER_MIN=60

# --- LLM -----------------------------------------------------------------
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Администрирование пользователей -------------------------------------
INVITE_TTL_HOURS=72
INVITE_RESEND_INTERVAL_SECONDS=300
INVITE_RESEND_PER_DAY=5
PASSWORD_CHANGE_MAX_ATTEMPTS=5
PASSWORD_CHANGE_LOCK_SECONDS=900
# 152-ФЗ: grace period перед обезличиванием и срок исполнения запроса субъекта.
ERASURE_GRACE_DAYS=30
ERASURE_SUBJECT_DEADLINE_DAYS=30
ADMIN_APPROVAL_TTL_SECONDS=86400

# --- Прочее --------------------------------------------------------------
CONSENT_POLICY_VERSION=1.0
CONSENT_POLICY_TEXT_HASH=
DOCS_ENABLED=true
OPENAPI_ENABLED=true

# --- Только для docker compose ------------------------------------------
POSTGRES_USER=crm
# СМЕНИТЬ ДЛЯ PROD
POSTGRES_PASSWORD=crm
# СМЕНИТЬ ДЛЯ PROD — пароль ограниченной роли crm_app, под которой реально
# подключаются api/worker (см. DATABASE_URL выше).
CRM_APP_PASSWORD=crm_app
POSTGRES_DB=crm
# Порт Postgres на хосте (для pgAdmin/psql снаружи). Не 5432: он часто занят
# локальным Postgres на сервере.
POSTGRES_PORT=5433
KEYCLOAK_ADMIN=admin
# СМЕНИТЬ ДЛЯ PROD
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
HTTP_PORT=8080
HTTPS_PORT=8443
# Проброс на хост порта S3-прокси Caddy (presigned-ссылки, см. Caddyfile).
S3_PROXY_PORT=8333
# Имя TLS-сайта в Caddyfile (SNI сертификата `tls internal`). На реальном
# сервере укажите его публичный домен/IP — иначе сертификат не совпадёт с именем.
CRM_TLS_HOST=localhost

# --- Режим TLS: off | internal | acme -------------------------------------------------
# Переменные ниже пишет scripts/gen_env.sh по флагу --tls (по умолчанию off — как здесь). Руками
# не менять: смена домена/режима на установленном стенде — scripts/set_host.sh.
#   off       локальный стенд: http://ХОСТ:HTTP_PORT, https://ХОСТ:HTTPS_PORT с самоподписанным сертификатом
#   internal  закрытый контур: HTTPS на 443, самоподписанный сертификат Caddy (для IP и внутренних имён)
#   acme      публичный домен: HTTPS на 443, сертификат Let's Encrypt (нужны DNS на этот сервер и 80/443 из интернета)
TLS_MODE=off
# Порт TLS-сайта Caddy внутри контейнера (в публичных режимах 443) и snippet Caddyfile с его TLS-настройками.
CRM_TLS_PORT=8443
CRM_TLS_SNIPPET=tls_internal
# Адрес сайта S3-прокси в Caddyfile (`:8333` — plain http; в публичных режимах `ХОСТ:8333` с TLS) и его snippet.
S3_SITE_ADDRESS=:8333
S3_TLS_SNIPPET=tls_none
# Где на хосте публикуется plain-http :8080 (в публичных режимах 127.0.0.1: Docker обходит ufw, наружу он не нужен).
HTTP_BIND=0.0.0.0
# Публикация контейнерного :80 (выпуск сертификата Let's Encrypt и редирект на https). Значение — вся
# спецификация: `127.0.0.1::80` = наружу не публикуем; в публичных режимах `80:80`.
CRM_PORT80_PUBLISH=127.0.0.1::80
# Каталог со шрифтами Rostelecom Basis (*.woff), лицензионными и не входящими в образ web. Не задан — берётся
# ./fonts рядом с compose (пустой каталог не ошибка: интерфейс использует запасную гарнитуру).
# FONTS_DIR=/абсолютный/путь/к/шрифтам
# Куда Caddy отдаёт всё, что не /api, /public, /health, /static и не /auth.
WEB_UPSTREAM=web:3000
# script-src в CSP страниц.
CSP_SCRIPT_SRC="'self'"
# Режим образа web: demo — экран входа предлагает выбрать демо-учётку;
# prod — только вход через Keycloak, без демо-учёток в /config.json.
APP_MODE=demo
# Один воркер на контейнер (см. комментарий в backend/.env.example).
# Масштабирование — репликами: docker compose up -d --scale api=3
UVICORN_WORKERS=1

# --- Только для этого (deploy) профиля --------------------------------------
# Ссылки на образы (API_IMAGE, WEB_IMAGE, POSTGRES_IMAGE, ...) в этом файле НЕ
# задаются: их генерирует scripts/render_env_images.py из ../images.yaml в
# отдельный .env.images (режимы digest / bundle / registry).
#
# Пути сгенерированных секретных конфигов (scripts/gen_env.sh создаёт runtime/
# и дописывает эти переменные). Без них берутся ДЕМО-файлы из репозитория —
# для боя недопустимо, потому что в них зашиты публичные секреты.
# SEAWEED_S3_CONFIG=./runtime/seaweedfs/s3.json
# KEYCLOAK_IMPORT_DIR=./runtime/keycloak
