engine-strict=true
# Приватный пакет дизайн-системы — из GitHub Packages (публикуется rt-ui/release.yml по тегу vX.Y.Z).
@lct-testkit:registry=https://npm.pkg.github.com
# ТОКЕН здесь не хранится и хранить его здесь бессмысленно: pnpm 11 игнорирует авторизацию из .npmrc внутри
# репозитория. Откуда он берётся:
#   локально  — pnpm config set "//npm.pkg.github.com/:_authToken" <classic PAT, scope read:packages>
#   CI        — actions/setup-node (registry-url) + NODE_AUTH_TOKEN=GITHUB_TOKEN (см. .github/workflows/ci.yml)
#   Docker    — BuildKit-секрет npm_token (см. Dockerfile)
