APP_NAME="ИТ-Школа РТК"
APP_ENV=local
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=ru

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL: отдельная база и роль `site`.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=site
DB_USERNAME=site
DB_PASSWORD=site
# Одноразовое создание роли и БД (учётка с CREATEROLE/CREATEDB); пусто — БД должна существовать.
SITE_DB_ADMIN_USER=
SITE_DB_ADMIN_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file

# Bearer-токен API для CRM. Пусто — API закрыт (всегда 401).
SITE_API_TOKEN=
SITE_SEED_DEMO=false

SITE_CONTACT_EMAIL=it-school@rtk.example
SITE_CONTACT_PHONE="+7 (800) 000-00-00"
SITE_CONTACT_ADDRESS="Москва, ул. Примерная, 1"
